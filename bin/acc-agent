#!/usr/bin/env python3
"""Run a CLI in an approved folder, one agent per tree. This is a concurrency guard, not a sandbox."""
import fcntl,hashlib,os,pathlib,subprocess,sys
sys.path.insert(0,str(pathlib.Path(__file__).resolve().parents[1]/'libexec'))
import acc_roots
owner=pathlib.Path(sys.argv[0]).name.removeprefix('acc-')
if owner not in ('claude','codex'): sys.exit('Use acc-claude or acc-codex')
args=sys.argv[1:];binary=os.environ.get('ACC_'+owner.upper()+'_BIN') or __import__('shutil').which(owner)
if not binary:sys.exit(owner+' CLI missing; run adcc doctor')
if args in (['--version'],['--help'],['login','status'],['auth','status']):os.execv(binary,[binary]+args)
cwd=pathlib.Path.cwd().resolve();workspace=acc_roots.workspace();tasks=workspace/'worktrees'
if not acc_roots.allowed(cwd):sys.exit(f'{cwd} is outside the approved workspace folders. Choose a project inside {workspace}, or approve its folder with: acc roots add PATH')
if not acc_roots.full_access() and any('dangerously' in x or x in ('bypassPermissions','danger-full-access') for x in args):sys.exit('Permission bypass is disabled by the control-center launcher')
# One writer per tree: a task worktree by its own folder, anything else by its Git top level, or the folder itself.
if cwd.is_relative_to(tasks) and cwd!=tasks:tree=tasks/cwd.relative_to(tasks).parts[0]
else:
 try:tree=pathlib.Path(subprocess.check_output(['git','-C',str(cwd),'rev-parse','--show-toplevel'],stderr=subprocess.DEVNULL,text=True).strip())
 except (subprocess.CalledProcessError,OSError):tree=cwd
locks=workspace/'tasks/leases';locks.mkdir(parents=True,exist_ok=True,mode=0o700)
path=locks/(hashlib.sha256(str(tree).encode()).hexdigest()+'.lock')
provided=os.environ.get('ACC_LEASE_FD')
if provided:
 try:
  fd=int(provided);actual=os.fstat(fd);expected=os.stat(path)
  if (actual.st_dev,actual.st_ino)!=(expected.st_dev,expected.st_ino):raise ValueError('Wrong inherited lease')
 except (ValueError,OSError):sys.exit('Invalid inherited worktree lease')
else:fd=os.open(str(path),os.O_CREAT|os.O_RDWR,0o600)
try:fcntl.flock(fd,fcntl.LOCK_EX|fcntl.LOCK_NB)
except BlockingIOError:sys.exit('Another agent owns this worktree; use a separate task worktree')
os.set_inheritable(fd,True)
os.execv(binary,[binary]+args)
